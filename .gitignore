# Ignore everything in the saves folder
saves/*

# But do not ignore the folder itself or a placeholder file
!saves/.gitkeep

# LibreSprite/Aseprite project files, the game reads the exported png
*.ase
*.aseprite

# Map previews rendered while tuning world generation
previews/

# The art selector's picks(../art-selector), rebuilt on every Apply, the game uses it when it is there
assets/art32_selected/
